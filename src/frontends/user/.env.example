# Biến môi trường của app (Vite). Copy thành `.env` cùng thư mục.
# Chỉ biến có tiền tố VITE_ được đưa vào code chạy trên trình duyệt (gắn cứng lúc build).

# Đường dẫn gốc của API mà trình duyệt gọi tới. Mặc định: /api/v1.
# API không bật CORS: phải là đường dẫn cùng domain (Vite proxy khi dev, nginx khi production).
VITE_API_BASE_URL=/api/v1

# Chỉ dùng cho dev server (`pnpm dev`): backend mà proxy /api trỏ tới. Mặc định: http://localhost:4000
API_PROXY_TARGET=http://localhost:4000
