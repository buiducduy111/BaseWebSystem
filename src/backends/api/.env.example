# =============================================================================
# Biến môi trường backend — file DUY NHẤT cho phía server.
# Đọc bởi: API (src/backends/api), script DB (`pnpm db:migrate`, `db:seed`, `db:generate`,
# `db:studio`) và test e2e (`pnpm test`).
# Copy thành `.env` cùng thư mục. Biến đặt sẵn trong môi trường (systemd, shell) được ưu tiên
# hơn giá trị trong file.
# Dòng bắt đầu bằng `#` là tuỳ chọn: bỏ `#` để ghi đè giá trị mặc định ghi trong chú thích.
# =============================================================================

# ----- Chung -----------------------------------------------------------------
# Môi trường chạy: development | test | production. Mặc định: development.
# production bật cờ Secure cho cookie (xem COOKIE_SECURE).
# NODE_ENV=production

# ----- Database --------------------------------------------------------------
# [Bắt buộc] Chuỗi kết nối PostgreSQL. Dùng chung cho API và script DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_web

# ----- HTTP server -----------------------------------------------------------
# Cổng lắng nghe của API. Mặc định: 4000.
PORT=4000
# Địa chỉ lắng nghe. Mặc định: 0.0.0.0. Production nên đặt 127.0.0.1 để chỉ nginx gọi vào.
HOST=0.0.0.0
# Proxy được tin header IP (CF-Connecting-IP, X-Forwarded-For): IP hoặc CIDR, phân tách bằng dấu phẩy.
# Mặc định chỉ loopback (nginx / cloudflared / proxy Vite cùng máy). Request từ IP khác: dùng IP kết nối.
# Ví dụ nginx ở máy khác: 127.0.0.1,::1,10.0.0.0/8
# TRUSTED_PROXIES=127.0.0.1,::1

# ----- Redis (rate limit) ----------------------------------------------------
# Lưu bộ đếm giới hạn số lần thử (đăng nhập, 2FA, quên mật khẩu…). Bắt buộc khi chạy nhiều
# instance API. Bỏ trống = lưu trong bộ nhớ (chỉ đúng khi chạy 1 instance).
# REDIS_URL=redis://127.0.0.1:6379/0
# Tiền tố key Redis, đổi khi nhiều app dùng chung 1 Redis. Mặc định: base-web:
# REDIS_KEY_PREFIX=base-web:

# ----- Bảo mật / token -------------------------------------------------------
# [Bắt buộc] Ký access token (JWT) và token tạm 2FA. Tối thiểu 32 ký tự, môi trường thật phải
# dùng chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# [Bắt buộc] Mã hoá secret 2FA trong DB. Tối thiểu 32 ký tự, khác JWT_SECRET.
# Đổi key sẽ làm mất hiệu lực 2FA của mọi user.
ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars
# Thời hạn access token (định dạng 15m, 1h, 1d…). Mặc định: 15m.
ACCESS_TOKEN_TTL=15m
# Số ngày sống của refresh token (phiên đăng nhập), 1–365. Mặc định: 7.
REFRESH_TOKEN_TTL_DAYS=7
# Bật cờ Secure cho cookie (bắt buộc khi chạy HTTPS). Mặc định: true khi NODE_ENV=production.
# COOKIE_SECURE=true

# ----- Ứng dụng --------------------------------------------------------------
# Tên hiển thị trong ứng dụng Authenticator, email và hộp thoại passkey. Mặc định: Base Web.
APP_NAME=Base Web
# URL trang user / admin: tạo link trong email (đặt lại mật khẩu), origin hợp lệ cho passkey.
USER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
# Thư mục lưu file upload (avatar). Đường dẫn tương đối tính từ thư mục chạy API.
# Mặc định: storage/uploads. Production nên dùng đường dẫn tuyệt đối ngoài thư mục code.
UPLOAD_DIR=storage/uploads

# ----- Passkey (WebAuthn) ----------------------------------------------------
# Domain gốc gắn passkey. Bỏ trống = hostname của USER_APP_URL.
# User và admin ở 2 subdomain khác nhau thì đặt domain chung, ví dụ: example.com
# WEBAUTHN_RP_ID=example.com
# Tên hiển thị trong hộp thoại passkey. Mặc định: APP_NAME.
# WEBAUTHN_RP_NAME=Base Web
# Origin được phép thêm (ngoài USER_APP_URL / ADMIN_APP_URL), phân tách bằng dấu phẩy.
# WEBAUTHN_ORIGINS=https://app2.example.com

# ----- Seed (chỉ dùng cho `pnpm db:seed`) ------------------------------------
# Tài khoản super admin tạo khi seed (bỏ qua nếu email đã tồn tại). Đổi mật khẩu ngay sau lần đầu.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# ----- Test (chỉ dùng cho `pnpm test`) ---------------------------------------
# Database cho test e2e — bị XOÁ và tạo lại mỗi lần chạy.
# Mặc định: DATABASE_URL với tên DB thêm hậu tố _test (ví dụ base_web_test).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_web_test
# Redis cho test rate limit dùng Redis thật. Bỏ trống = bỏ qua các test này.
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
